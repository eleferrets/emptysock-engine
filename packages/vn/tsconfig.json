{
  "extends": "../../tsconfig.module-package.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types"],
    // VNTextbox.ts/VNBackgroundLayer.ts touch `document.createElement("canvas")`
    // behind runtime guards, so this package genuinely needs the DOM lib —
    // unlike battle/tilemap/network, which don't and stay on the shared
    // ES2024-only default.
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": ["src"]
}

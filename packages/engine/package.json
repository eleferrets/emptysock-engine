{
  "name": "@emptysock/engine",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./testing": {
      "import": "./dist/testing/index.js",
      "types": "./dist/testing/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "build:types": "tsc -p tsconfig.types.json --emitDeclarationOnly --outDir dist-types --declaration --declarationMap false --skipLibCheck",
    "gpu-verify": "node scripts/gpu-verify.mjs"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.20.0",
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@emptysock/types": "workspace:*",
    "bitecs": "^0.4.0",
    "howler": "^2.2.4",
    "pixi-filters": "^6.1.5",
    "pixi.js": "catalog:",
    "yoga-layout": "^3.2.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "@vitest/browser": "^5.0.0",
    "jsdom": "^30.0.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

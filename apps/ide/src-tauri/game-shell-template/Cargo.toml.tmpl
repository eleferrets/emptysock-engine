[package]
name = "{{package_name}}"
version = "0.1.0"
description = "EmptySock exported game"
authors = ["EmptySock"]
license = "UNLICENSED"
edition = "2021"
rust-version = "1.77.2"

[build-dependencies]
tauri-build = { version = "2.6.3" }

[dependencies]
serde_json = "1.0"
serde = { version = "1.0", features = ["derive"] }
tauri = { version = "2.11.3" }

[[bin]]
name = "{{package_name}}"
path = "src/main.rs"

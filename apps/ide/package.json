{
  "name": "@emptysock/ide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "engine-runtime": "node engine-runtime.build.mjs",
    "copy-docs": "node scripts/copy-docs.mjs",
    "predev": "node engine-runtime.build.mjs && node scripts/copy-docs.mjs",
    "prebuild": "node engine-runtime.build.mjs && node scripts/copy-docs.mjs",
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@emptysock/engine": "workspace:*",
    "@emptysock/types": "workspace:*",
    "@monaco-editor/react": "^4.6.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tauri-apps/api": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild-wasm": "^0.28.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.469.0",
    "monaco-editor": "0.55.1",
    "pixi.js": "catalog:",
    "rc-dock": "^3.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "catalog:",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/jszip": "^3.4.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^3.4.17",
    "typescript": "catalog:",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "catalog:"
  }
}
